# Nothing here is required.
#
# The app finds the City of Portland's GIS layers by itself: it searches the
# candidate services in src/lib/gis/config.ts, matches layers by NAME rather
# than by index, and falls back to the ArcGIS Online web map the city
# publishes — so a republished service with renumbered layers fixes itself.
#
# Set a variable here only when /diagnostics reports a layer as UNRESOLVED.
# A value set here is used verbatim and skips discovery entirely.

# --- Layer overrides. Each must be a full layer URL ending in an index. ---
# PORTLAND_PARCEL_LAYER=https://gis.portlandmaine.gov/maps/rest/services/Development_Review_Parcels/MapServer/0
# PORTLAND_ZONING_LAYER=https://gis.portlandmaine.gov/maps/rest/services/Zoning/MapServer/5
# PORTLAND_OVERLAY_LAYER=
# PORTLAND_SHORELAND_LAYER=
# PORTLAND_STREAM_LAYER=
# PORTLAND_COASTAL_LAYER=
# PORTLAND_STREETS_LAYER=
# PORTLAND_HISTORIC_LAYER=
# The city's own address points (E911). Optional; used before the Census geocoder.
# PORTLAND_ADDRESS_POINTS_LAYER=
# FEMA_NFHL_LAYER=https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer/28

# --- Where discovery looks. Change these if the whole server moves. ---
# Root of the City of Portland ArcGIS REST services directory.
# PORTLAND_GIS_ROOT=https://gis.portlandmaine.gov/maps/rest/services

# The city's public Parcel Viewer web map. Discovery reads its operational
# layers to find services that have been renamed or moved hosts.
# PORTLAND_AGOL_WEBMAP_ITEM=6208128831ea40c7a7c432317527336b

# Maine GeoLibrary's statewide parcel layer, used only if every Portland
# parcel candidate fails. Carries no zoning.
# MAINE_PARCELS_AGOL_ITEM=346131b710a645ffb624f448a9cba6d4

# ArcGIS Online sharing API, for the two items above.
# AGOL_SHARING_URL=https://www.arcgis.com/sharing/rest

# US Census Bureau geocoder, used only when the parcel layer's address field misses.
# CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress

# --- Tuning ---
# Timeout for a single upstream GIS request, in milliseconds.
# GIS_TIMEOUT_MS=12000
# How long a successful endpoint resolution is reused. Failures are always retried.
# GIS_DISCOVERY_TTL_MS=3600000
