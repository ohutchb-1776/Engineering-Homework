# Nothing here is required. The app runs with no configuration at all: every
# data source it uses is a public, keyless endpoint, and there is no database,
# no auth and no LLM.
#
# These variables exist for one reason: municipal ArcGIS services get
# republished and their layer numbers move. When `npm run gis:probe` reports a
# layer as FAIL, copy this file to `.env.local` and point the variable at the
# URL the probe found.

# Root of the City of Portland ArcGIS REST services directory.
# PORTLAND_GIS_ROOT=https://gis.portlandmaine.gov/maps/rest/services

# Individual layers, if only one of them has moved.
# PORTLAND_PARCEL_LAYER=https://gis.portlandmaine.gov/maps/rest/services/Development_Review_Parcels/MapServer/0
# PORTLAND_ZONING_LAYER=https://gis.portlandmaine.gov/maps/rest/services/Zoning/MapServer/5
# PORTLAND_OVERLAY_LAYER=https://gis.portlandmaine.gov/maps/rest/services/Zoning/MapServer/6
# PORTLAND_SHORELAND_LAYER=https://gis.portlandmaine.gov/maps/rest/services/Zoning/MapServer/2
# PORTLAND_STREAM_LAYER=https://gis.portlandmaine.gov/maps/rest/services/Zoning/MapServer/3
# PORTLAND_COASTAL_LAYER=https://gis.portlandmaine.gov/maps/rest/services/Zoning/MapServer/1
# PORTLAND_STREETS_LAYER=https://gis.portlandmaine.gov/maps/rest/services/transportation/Streets/MapServer/0
# PORTLAND_HISTORIC_LAYER=https://gis.portlandmaine.gov/maps/rest/services/Historic/MapServer/0

# FEMA National Flood Hazard Layer (flood hazard areas).
# FEMA_NFHL_LAYER=https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer/28

# US Census Bureau geocoder, used only when the parcel layer's address field misses.
# CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress

# Timeout for a single upstream GIS request, in milliseconds.
# GIS_TIMEOUT_MS=12000
